# Configuración de Inteligencia Artificial (Gemini Enterprise / Vertex AI)
GEMINI_API_KEY=

# Configuración de Puerto del Servidor Express
PORT=3000

# Configuración para envío de correos (SMTP)
# Reemplaza con tus credenciales reales (ej. Gmail, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
# Si usas Gmail, debes generar una "Contraseña de aplicación" en la seguridad de tu cuenta de correo
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
